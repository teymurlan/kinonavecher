{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinonavecher",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/telegram/*", "/health"]
  },
  "vars": {
    "ALLOWED_TELEGRAM_IDS": "835372319",
    "ACCOUNTANT_TELEGRAM_IDS": "",
    "GOOGLE_SHEET_ID": "1gL-kJhrKT8EtONtVDGO-c9kRftoG638U",
    "GOOGLE_AUDIT_WORKSHEET": "Журнал",
    "APP_TIMEZONE": "Europe/Moscow",
    "TELEGRAM_INIT_DATA_MAX_AGE": "86400"
  }
}
